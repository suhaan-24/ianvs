+    def inference_2(self, data=None, post_process=None, **kwargs):
+        """Simplified inference using cloud KB for local/standalone testing."""
+        task_index_url = Context.get_parameters(
+            "MODEL_URLS", self.cloud_knowledge_management.task_index)
+        index_url = self.cloud_knowledge_management.local_task_index_url
+        if not os.path.exists(index_url):
+            FileOps.download(task_index_url, index_url)
+        callback_func = None
+        if callable(post_process):
+            callback_func = post_process
+        elif post_process is not None:
+            callback_func = ClassFactory.get_cls(ClassType.CALLBACK, post_process)
+
+        # Detect unseen samples using the configured recognition method
+        try:
+            method_name = (
+                self.unseen_sample_recognition.get("method", "SampleRegonitionDefault")
+                if isinstance(self.unseen_sample_recognition, dict)
+                else "SampleRegonitionDefault"
+            )
+            recognizer = ClassFactory.get_cls(ClassType.UTD, method_name)(index_url)
+            _, unseen_samples = recognizer(data)
+            is_unseen_task = len(unseen_samples.x) > 0
+        except Exception as e:
+            self.log.warning(f"Unseen sample detection failed: {e}")
+            is_unseen_task = False
+
+        res, tasks = self.cloud_knowledge_management.seen_estimator.predict(
+            data=data, task_index=index_url, task_type="seen_task", **kwargs)
+        return (callback_func(res) if callback_func else res), is_unseen_task, tasks
