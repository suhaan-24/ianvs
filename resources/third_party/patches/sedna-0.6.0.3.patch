+def _sample_key(sample):
+    """File names of a sample, independent of where the dataset lives."""
+    if isinstance(sample, (str, bytes)):
+        parts = [sample]
+    else:
+        try:
+            parts = list(sample)
+        except TypeError:
+            parts = [sample]
+    return "|".join(os.path.basename(str(part)) for part in parts)
